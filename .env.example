# rag-lab environment reference — copy to .env and source it:
#   set -a; source .env; set +a
# The app does NOT auto-load .env; config.py reads the process environment only.

# --- LLM (OpenAI-compatible endpoint; OpenRouter preferred) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3.7-plus
# LLM_VERIFIER_MODEL=qwen/qwen3.7-plus

# --- Local retrieval models (downloaded on first use) ---
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Corpus ---
# RAG_DB_PATH=~/.local/share/rag-lab/chroma_db
# RAG_COLLECTION=

# --- Web API ---
# Bearer token for /api routes; `rag serve` refuses non-loopback binds without it.
# RAG_API_TOKEN=
# RAG_MAX_UPLOAD_MB=200
# RAG_EVAL_DIR=./eval
# RAG_OCR_LANGS=deu+eng

# --- LLM call behavior ---
# LLM_TIMEOUT=180
# LLM_VERIFIER_TIMEOUT=120
# LLM_MAX_RETRIES=2
